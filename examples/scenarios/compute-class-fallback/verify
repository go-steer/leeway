. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ verify compute-class-fallback (1/3: leeway report CLI)"
report_json="$(run_leeway report --sources=compute-class --namespace=leeway-cc)"

grep -Eq '"kind": *"leeway\.rank_wedged"' <<<"$report_json" || {
  echo "  ✗ leeway report missing leeway.rank_wedged" >&2
  echo "$report_json" >&2
  exit 1
}
grep -Eq '"kind": *"leeway\.rank_degraded"' <<<"$report_json" || {
  echo "  ✗ leeway report missing leeway.rank_degraded" >&2
  echo "$report_json" >&2
  exit 1
}
grep -Eq '"pendingDeclined": *1' <<<"$report_json" || {
  echo "  ✗ leeway report expected pendingDeclined: 1" >&2
  echo "$report_json" >&2
  exit 1
}
grep -Eq '"pendingProvisioning": *1' <<<"$report_json" || {
  echo "  ✗ leeway report expected pendingProvisioning: 1" >&2
  echo "$report_json" >&2
  exit 1
}
echo "  ✓ leeway report returned leeway.rank_wedged and leeway.rank_degraded (pendingDeclined=1, pendingProvisioning=1)"

echo "▸ verify compute-class-fallback (2/3: leeway watch webhook open)"
await_inject compute-class-fallback 180 'INCIDENT-OPEN' 'leeway\.rank_wedged' 'gold-ccc'
await_inject compute-class-fallback 180 'INCIDENT-OPEN' 'leeway\.rank_degraded' 'gold-ccc' 'last-rank'

echo "▸ verify compute-class-fallback (3/3: deleting pod-wedged resolves leeway.rank_wedged while pod-provisioning stays Pending)"
kubectl -n leeway-cc delete pod pod-wedged --wait=true >/dev/null
await_inject compute-class-fallback 180 'INCIDENT-EVENT' 'kind=resolved' '"resolution":"recovered"'
