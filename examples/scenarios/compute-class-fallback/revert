. "$(dirname "$0")/../../lib.sh"
require_examples_context

target="${CLUSTER_NAME}-worker2"
echo "▸ removing namespace leeway-cc and ComputeClass gold-ccc"
kubectl delete namespace leeway-cc --ignore-not-found --wait=false
kubectl delete computeclass gold-ccc --ignore-not-found >/dev/null 2>&1 || true

echo "▸ removing compute-class labels and annotations from $target"
kubectl label node "$target" \
  cloud.google.com/compute-class- \
  cloud.google.com/machine-family- \
  >/dev/null 2>&1 || true
kubectl annotate node "$target" ccc_priority_index- >/dev/null 2>&1 || true
