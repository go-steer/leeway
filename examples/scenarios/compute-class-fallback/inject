. "$(dirname "$0")/../../lib.sh"
require_examples_context

target="${CLUSTER_NAME}-worker2"
await_namespace_settled leeway-cc

echo "▸ installing ComputeClass CRD (cloud.google.com/v1)"
kubectl apply -f "$(dirname "$0")/crd.yaml" >/dev/null
kubectl wait --for=condition=Established crd/computeclasses.cloud.google.com --timeout=60s >/dev/null

echo "▸ labelling and annotating $target as a rank-1 (n2) node for gold-ccc"
kubectl label node "$target" \
  cloud.google.com/compute-class=gold-ccc \
  cloud.google.com/machine-family=n2 \
  --overwrite >/dev/null
kubectl annotate node "$target" ccc_priority_index="1" --overwrite >/dev/null

if ! kubectl -n "$SENTINEL_NS" get deploy leeway -o jsonpath='{.spec.template.spec.containers[0].args}' 2>/dev/null | grep -q 'compute-class'; then
  echo "▸ ensuring leeway watcher has compute-class enabled"
  "$(examples_root)/watcher/up" >/dev/null
fi

stub_mark compute-class-fallback
echo "▸ deploying gold-ccc ComputeClass, running fallback pod, wedged pod, and provisioning pod"
kubectl apply -f "$(dirname "$0")/workloads.yaml" >/dev/null
kubectl -n leeway-cc wait --for=condition=Ready pod/pod-running-rank1 --timeout=120s >/dev/null

wedged_uid="$(kubectl -n leeway-cc get pod pod-wedged -o jsonpath='{.metadata.uid}')"
prov_uid="$(kubectl -n leeway-cc get pod pod-provisioning -o jsonpath='{.metadata.uid}')"
now_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

kubectl apply -f - >/dev/null <<EOF
apiVersion: v1
kind: Event
metadata:
  name: pod-wedged-declined
  namespace: leeway-cc
involvedObject:
  apiVersion: v1
  kind: Pod
  name: pod-wedged
  namespace: leeway-cc
  uid: ${wedged_uid}
reason: NotTriggerScaleUp
message: "pod didn't trigger scale-up: 1 max node group size reached"
source:
  component: cluster-autoscaler
firstTimestamp: "${now_ts}"
lastTimestamp: "${now_ts}"
count: 1
type: Normal
---
apiVersion: v1
kind: Event
metadata:
  name: pod-provisioning-scaleup
  namespace: leeway-cc
involvedObject:
  apiVersion: v1
  kind: Pod
  name: pod-provisioning
  namespace: leeway-cc
  uid: ${prov_uid}
reason: TriggeredScaleUp
message: "pod triggered scale-up"
source:
  component: cluster-autoscaler
firstTimestamp: "${now_ts}"
lastTimestamp: "${now_ts}"
count: 1
type: Normal
EOF

echo "T0: ${now_ts} — rank_wedged expected after 20s dwell; rank_degraded after 30s window + 20s dwell"
