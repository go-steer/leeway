. "$(dirname "$0")/../../lib.sh"
require_examples_context

is_kind_context || {
  echo "ERROR: zone-unavailable is kind-only (it labels and cordons nodes)." >&2
  exit 1
}

target="${CLUSTER_NAME}-worker2"

on_target="$(kubectl -n "$SENTINEL_NS" get pods \
  -o jsonpath='{range .items[*]}{.spec.nodeName}{"\n"}{end}' | grep -cx "$target" || true)"
if ((on_target > 0)); then
  echo "ERROR: $on_target agent-triage pod(s) run on $target. Re-run" >&2
  echo "examples/watcher/up (it pins leeway + stub-webhook to ${CLUSTER_NAME}-worker)." >&2
  exit 1
fi

leeway_zones
kubectl uncordon "$target" >/dev/null
await_namespace_settled leeway-zone

echo "▸ deploying zone-hard (DoNotSchedule x2) + zone-soft (ScheduleAnyway x4) across both zones"
kubectl apply -f "$(dirname "$0")/workloads.yaml" >/dev/null
for d in zone-hard zone-soft; do
  kubectl -n leeway-zone rollout status "deploy/$d" --timeout=180s
done
kubectl -n leeway-zone get pods -o jsonpath='{range .items[*]}{.spec.nodeName}{"\n"}{end}' |
  sort | uniq -c | sed 's/^/    /'

sleep 20

stub_mark zone-unavailable
echo "▸ cordoning $target: zone-b has no node the scheduler can use"
kubectl cordon "$target" >/dev/null
echo "T0: $(date -u +%Y-%m-%dT%H:%M:%SZ) — domain finding expected after the 30s dwell"
