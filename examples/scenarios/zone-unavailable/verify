. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ verify zone-unavailable (1/2: leeway report CLI)"
report_json="$(run_leeway report \
  --sources=topology-drift \
  --namespace=leeway-zone \
  --topology-keys="topology.kubernetes.io/zone,topology.kubernetes.io/region,$LEEWAY_ZONE_KEY" \
  --topology-domain-unavailable-keys="topology.kubernetes.io/zone,topology.kubernetes.io/region,$LEEWAY_ZONE_KEY")"

grep -Eq '"kind": *"leeway\.domain_unavailable"' <<<"$report_json" || {
  echo "  ✗ leeway report missing leeway.domain_unavailable" >&2
  echo "$report_json" >&2
  exit 1
}
grep -Eq '"suspectedCause": *"taint_exclusion"' <<<"$report_json" || {
  echo "  ✗ leeway report missing suspectedCause: taint_exclusion" >&2
  echo "$report_json" >&2
  exit 1
}
if grep -Eq '"kind": *"leeway\.(contract_violated|placement_drift)"' <<<"$report_json"; then
  echo "  ✗ leeway report emitted per-workload drift during zone unavailability" >&2
  echo "$report_json" >&2
  exit 1
fi
echo "  ✓ leeway report returned leeway.domain_unavailable (zone-b, taint_exclusion) and 0 per-workload findings"

echo "▸ verify zone-unavailable (2/2: leeway watch webhook)"
await_inject zone-unavailable 180 'INCIDENT-OPEN' 'leeway\.domain_unavailable' 'zone-b' 'taint_exclusion'

hold=$((45 * ${LEEWAY_E2E_TIMEOUT_SCALE:-1}))
echo "▸ holding ${hold}s to ensure no duplicate or per-workload findings arrive"
sleep "$hold"

n="$(leeway_wire_count zone-unavailable 'leeway\.domain_unavailable')"
if ((n != 1)); then
  echo "  ✗ $n leeway.domain_unavailable line(s) on the wire, want exactly 1" >&2
  stub_since zone-unavailable | grep -E 'leeway\.domain_unavailable' | cut -c1-200 | sed 's/^/    wire: /' >&2
  exit 1
fi
echo "  ✓ exactly one leeway.domain_unavailable"

n="$(leeway_wire_count zone-unavailable 'leeway\.(contract_violated|placement_drift)' 'zone-(hard|soft)')"
if ((n > 0)); then
  echo "  ✗ $n per-workload leeway finding(s) for the zone's workloads" >&2
  stub_since zone-unavailable | grep -E 'leeway\.(contract_violated|placement_drift)' | cut -c1-200 | sed 's/^/    wire: /' >&2
  exit 1
fi
echo "  ✓ no per-workload leeway finding for zone-hard or zone-soft"
