# Add a fake fleet of N nodes and a synthetic workload set on top of
# them to the current cluster:
#
#   examples/kwok/scale-up [nodes] [workloads] [replicas]
#   examples/kwok/scale-up 300 400 3       # 300 nodes, 400 workloads
#
# Defaults: 100 nodes, 200 workloads, 3 replicas.
#
# THE ARGUMENTS ARE ABSOLUTE, NOT INCREMENTS. Nodes are named
# kwok-node-0000 upward and workloads svc-0000 upward, both from zero,
# so running this twice with the same N re-applies the same objects and
# the fleet does not grow — which is what makes it safe to re-run, and
# what makes a scale LADDER a sequence of increasing sizes rather than a
# sequence of increments. `scale-up 100` then `scale-up 200` leaves 200
# nodes; `scale-up 100` twice leaves 100.
#
# Every fake node carries the kwok.x-k8s.io/node=fake NoSchedule taint
# and every generated pod tolerates it, so the fake fleet and the real
# kind workloads never mix: nothing real lands on a node with no
# kubelet, and nothing fake displaces leeway watch or real workloads.
#
# The fleet cycles through ten posture archetypes:
#
#   0 sound          PDB, probes, spread, requests — emits nothing
#   1 no-pdb         no PodDisruptionBudget
#   2 singleton      replicas: 1, no PDB
#   3 no-probes      no readiness/liveness probe
#   4 no-spread      no topology spread constraint
#   5 pinned         nodeSelector onto exactly one node
#   6 privileged     securityContext.privileged
#   7 host-ns        hostNetwork + hostPID
#   8 hostpath       hostPath mount of /var/lib
#   9 cron-suspended a CronJob left suspended

. "$(dirname "$0")/lib.sh"
require_examples_context
require_kwok_installed

NODES="${1:-100}"
WORKLOADS="${2:-200}"
REPLICAS="${3:-3}"

# Nine, not ten: the three PSA tiers must divide the namespaces evenly,
# and rerouting a hardening archetype off an enforcing namespace by +1
# must always land on a non-enforcing one.
NAMESPACES=9

for n in "$NODES" "$WORKLOADS" "$REPLICAS"; do
  [[ "$n" =~ ^[0-9]+$ ]] && ((n > 0)) || {
    echo "ERROR: arguments must be positive integers (got '$n')" >&2
    echo "Usage: examples/kwok/scale-up [nodes] [workloads] [replicas]" >&2
    exit 2
  }
done

# Exact pod count: the CronJob archetype creates none until it is
# unsuspended, and the singleton archetype creates one.
pods=0
for ((i = 0; i < WORKLOADS; i++)); do
  case $((i % 10)) in
  9) ;;
  2) pods=$((pods + 1)) ;;
  *) pods=$((pods + REPLICAS)) ;;
  esac
done

capacity=$((NODES * 110))
if ((pods > capacity)); then
  echo "ERROR: this fleet needs $pods pods, but $NODES nodes hold $capacity." >&2
  echo "Raise the node count or lower the replicas." >&2
  exit 2
fi
pinned_workloads=$(((WORKLOADS + 4) / 10))
max_pinned_per_node=$(((pinned_workloads + NODES - 1) / NODES))
if ((max_pinned_per_node * REPLICAS > 110)); then
  echo "ERROR: pinned archetype places $((max_pinned_per_node * REPLICAS)) pods on one node (allocatable.pods=110)." >&2
  echo "Raise the node count or lower the replicas." >&2
  exit 2
fi

# kind's default pod subnet is 10.244.0.0/16 and node-ipam hands out a
# /24 per node, so it runs dry at 256 nodes: every node past that gets
# a CIDRNotAvailable event and no podCIDR.
if is_kind_context && ((NODES > 250)); then
  echo "  ⚠ $NODES nodes exceeds what kind's default 10.244.0.0/16 pod subnet can" >&2
  echo "    allocate (/24 per node = 256). Expect CIDRNotAvailable events on the" >&2
  echo "    overflow (or use examples/kwok/kwokctl-up for 100k+ pod tiers)." >&2
fi

# ---- CNI headroom --------------------------------------------------------

kindnet_headroom() {
  kubectl -n kube-system get ds kindnet >/dev/null 2>&1 || return 0

  local cur want
  cur="$(kubectl -n kube-system get ds kindnet \
    -o jsonpath='{.spec.template.spec.containers[0].resources.limits.memory}' 2>/dev/null)"
  [[ "$cur" =~ ^([0-9]+)Mi$ ]] || return 0

  want=$((128 + NODES))
  ((${BASH_REMATCH[1]} >= want)) && return 0

  echo "▸ raising kindnet's memory limit ${cur} → ${want}Mi for $NODES nodes"
  echo "  (restored by examples/kwok/scale-down)"
  if [[ -z "$(kubectl -n kube-system get ds kindnet \
    -o "jsonpath={.metadata.annotations['${KINDNET_LIMIT_ANNOTATION//./\\.}']}" 2>/dev/null)" ]]; then
    kubectl -n kube-system annotate ds kindnet \
      "${KINDNET_LIMIT_ANNOTATION}=${cur}" >/dev/null
  fi
  kubectl -n kube-system set resources ds kindnet --limits="memory=${want}Mi" >/dev/null
}
kindnet_headroom

echo "▸ generating $NODES fake nodes, $WORKLOADS workloads, $pods pods"

# ---- nodes ---------------------------------------------------------------

node_name() { printf 'kwok-node-%04d' "$1"; }

kwok_ip="$(kwok_host_ip)"
if [[ -z "$kwok_ip" ]]; then
  echo "ERROR: could not read the kwok controller's host IP." >&2
  echo "Fake nodes need it as their InternalIP. Re-run examples/kwok/up or examples/kwok/kwokctl-up." >&2
  exit 1
fi

# Precompute the static padding block once rather than forking ~125
# subshells per node across 2,000+ nodes.
NODE_IMAGES_BLOCK="$(pad_node_images)"

emit_nodes() {
  local i name
  for ((i = 0; i < NODES; i++)); do
    printf -v name 'kwok-node-%04d' "$i"
    cat <<EOF
---
apiVersion: v1
kind: Node
metadata:
  name: ${name}
  annotations:
    node.alpha.kubernetes.io/ttl: "0"
    ${FAKE_NODE_ANNOTATION}: ${FAKE_NODE_ANNOTATION_VALUE}
  labels:
    beta.kubernetes.io/arch: amd64
    beta.kubernetes.io/os: linux
    kubernetes.io/arch: amd64
    kubernetes.io/hostname: ${name}
    kubernetes.io/os: linux
    kubernetes.io/role: agent
    node-role.kubernetes.io/agent: ""
    topology.kubernetes.io/zone: zone-$((i % 3))
    type: kwok
spec:
  taints:
  - effect: NoSchedule
    key: ${FAKE_NODE_TAINT_KEY}
    value: ${FAKE_NODE_ANNOTATION_VALUE}
status:
  addresses:
  - address: ${kwok_ip}
    type: InternalIP
  - address: ${name}
    type: Hostname
  allocatable:
    cpu: "32"
    memory: 256Gi
    pods: "110"
  capacity:
    cpu: "32"
    memory: 256Gi
    pods: "110"
  nodeInfo:
    architecture: amd64
    kubeProxyVersion: fake
    kubeletVersion: fake
    operatingSystem: linux
  phase: Running
${NODE_IMAGES_BLOCK}
EOF
  done
}

# Shard multi-document streams into chunks of $KWOK_APPLY_CHUNK_DOCS
# (default 250) and apply up to $KWOK_APPLY_JOBS (default 8) chunks in
# parallel while keeping client-side `kubectl apply` (so S8's
# last-applied-configuration weight stays identical). Retries once if a
# chunk hits a transient etcd timeout.
apply_stdin() {
  local what="$1" tmpdir rc=0
  local chunk_docs="${KWOK_APPLY_CHUNK_DOCS:-250}"
  local jobs="${KWOK_APPLY_JOBS:-8}"
  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/kwok-apply.XXXXXX")"
  awk -v dir="$tmpdir" -v max="$chunk_docs" '
    /^---$/ {
      if (docs > 0 && docs % max == 0) {
        close(out)
        part++
      }
      docs++
    }
    {
      if (out == "" || prev_part != part) {
        out = sprintf("%s/part-%05d.yaml", dir, part)
        prev_part = part
      }
      print > out
    }
  '
  local -a parts=("$tmpdir"/part-*.yaml)
  if [[ ! -e "${parts[0]}" ]]; then
    rm -rf "$tmpdir"
    return 0
  fi
  _apply_chunk() {
    local f="$1" label="$2"
    if ! kubectl apply -f "$f" >/dev/null; then
      echo "  … etcd busy applying $label ($(basename "$f")); retrying once in 15s" >&2
      sleep 15
      kubectl apply -f "$f" >/dev/null
    fi
  }
  if ((${#parts[@]} == 1 || jobs <= 1)); then
    local f
    for f in "${parts[@]}"; do
      _apply_chunk "$f" "$what" || rc=1
    done
  else
    local active=0 f
    for f in "${parts[@]}"; do
      _apply_chunk "$f" "$what" &
      active=$((active + 1))
      if ((active >= jobs)); then
        wait -n || rc=1
        active=$((active - 1))
      fi
    done
    while ((active > 0)); do
      wait -n || rc=1
      active=$((active - 1))
    done
  fi
  rm -rf "$tmpdir"
  return "$rc"
}

emit_nodes | apply_stdin nodes
echo "▸ waiting for kwok to bring them Ready"
target_nodes="$(fake_node_count)"
((target_nodes < NODES)) && target_nodes="$NODES"
node_timeout=300
((target_nodes >= 1500)) && node_timeout=900
node_deadline=$((SECONDS + node_timeout))
while :; do
  ready_nodes="$(kubectl get nodes -l "$FAKE_NODE_LABEL" --chunk-size=0 --no-headers 2>/dev/null \
    | awk '$2 == "Ready" || $2 ~ /^Ready,/ {c++} END {print c+0}')"
  ((ready_nodes >= target_nodes)) && break
  if ((SECONDS >= node_deadline)); then
    printf '\r  ✗ only %s/%s fake nodes Ready after %ss\n' "$ready_nodes" "$target_nodes" "$node_timeout" >&2
    exit 1
  fi
  printf '\r  … %s/%s Ready ' "$ready_nodes" "$target_nodes"
  sleep 2
done
printf '\r  ✓ %s fake nodes Ready          \n' "$ready_nodes"

# ---- namespaces ----------------------------------------------------------

ns_name() { printf '%s-%02d' "$FLEET_NS_PREFIX" "$1"; }

emit_namespaces() {
  local i ns
  for ((i = 0; i < NAMESPACES; i++)); do
    ns="$(ns_name "$i")"
    cat <<EOF
---
apiVersion: v1
kind: Namespace
metadata:
  name: ${ns}
  labels:
    ${FLEET_LABEL%%=*}: ${FLEET_LABEL##*=}
EOF
    case $((i % 3)) in
    0) # enforcing, and network-isolated
      cat <<EOF
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny
  namespace: ${ns}
  labels:
    ${FLEET_LABEL%%=*}: ${FLEET_LABEL##*=}
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
EOF
      ;;
    1) # dry-run: labelled, enforces nothing
      cat <<EOF
    pod-security.kubernetes.io/audit: baseline
    pod-security.kubernetes.io/warn: baseline
EOF
      ;;
    esac
  done
}

emit_namespaces | apply_stdin namespaces
echo "  ✓ $NAMESPACES namespaces across three PSA tiers"

# ---- workloads -----------------------------------------------------------

tolerations_block() {
  cat <<EOF
      tolerations:
      - key: ${FAKE_NODE_TAINT_KEY}
        operator: Equal
        value: ${FAKE_NODE_ANNOTATION_VALUE}
        effect: NoSchedule
EOF
}

probes_block() {
  cat <<'EOF'
        readinessProbe:
          httpGet: {path: /healthz, port: 8080}
          periodSeconds: 10
        livenessProbe:
          httpGet: {path: /healthz, port: 8080}
          periodSeconds: 30
EOF
}

emit_pdb() {
  cat <<EOF
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: $2
  namespace: $1
  labels:
    ${FLEET_LABEL%%=*}: ${FLEET_LABEL##*=}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: $2
EOF
}

# Precompute invariant blocks once so emitting thousands of workloads
# executes zero subshell forks in the loop.
POD_ANNOTATIONS_BLOCK="$(pad_pod_annotations)"
POD_ENV_BLOCK="$(pad_pod_env)"
TOLERATIONS_BLOCK="$(tolerations_block)"
CRON_TOLERATIONS_BLOCK="$(tolerations_block | sed 's/^      /          /')"
PROBES_BLOCK="$(probes_block)"

emit_workload() {
  local i="$1"
  local arch=$((i % 10))
  local ns_idx=$(((i / 10) % NAMESPACES))
  local ns name pin_node replicas="$REPLICAS"

  if ((arch >= 6 && arch <= 8 && ns_idx % 3 == 0)); then
    ns_idx=$((ns_idx + 1))
  fi
  printf -v ns '%s-%02d' "$FLEET_NS_PREFIX" "$ns_idx"
  printf -v name 'svc-%04d' "$i"

  if ((arch == 9)); then
    cat <<EOF
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: ${name}
  namespace: ${ns}
  labels:
    ${FLEET_LABEL%%=*}: ${FLEET_LABEL##*=}
spec:
  schedule: "*/5 * * * *"
  suspend: true
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app: ${name}
            ${FLEET_LABEL%%=*}: ${FLEET_LABEL##*=}
        spec:
          restartPolicy: OnFailure
          nodeSelector:
            type: kwok
${CRON_TOLERATIONS_BLOCK}
          containers:
          - name: job
            image: fake-image:v1
            resources:
              requests: {cpu: 100m, memory: 128Mi}
EOF
    return 0
  fi

  ((arch == 2)) && replicas=1

  cat <<EOF
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${name}
  namespace: ${ns}
  labels:
    app: ${name}
    ${FLEET_LABEL%%=*}: ${FLEET_LABEL##*=}
spec:
  replicas: ${replicas}
  revisionHistoryLimit: 2
  selector:
    matchLabels:
      app: ${name}
  template:
    metadata:
      labels:
        app: ${name}
        ${FLEET_LABEL%%=*}: ${FLEET_LABEL##*=}
${POD_ANNOTATIONS_BLOCK}
    spec:
      nodeSelector:
        type: kwok
EOF

  # pinned: narrow placement to exactly one node. Divide by 10 first:
  # `i` always ends in 5 here, so `i % NODES` on any decimal node count
  # uses only NODES/10 nodes and stacks two 50-replica Deployments onto
  # one node.
  if ((arch == 5)); then
    printf -v pin_node 'kwok-node-%04d' "$(((i / 10) % NODES))"
    printf '        kubernetes.io/hostname: %s\n' "$pin_node"
  fi

  printf '%s\n' "$TOLERATIONS_BLOCK"

  case "$arch" in
  7) printf '      hostNetwork: true\n      hostPID: true\n' ;;
  8)
    cat <<'EOF'
      volumes:
      - name: hostlib
        hostPath:
          path: /var/lib
EOF
    ;;
  esac

  if ((arch != 4 && arch != 5)); then
    cat <<EOF
      topologySpreadConstraints:
      - maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: ScheduleAnyway
        labelSelector:
          matchLabels:
            app: ${name}
EOF
  fi

  cat <<EOF
      containers:
      - name: app
        image: fake-image:v1
EOF

  ((arch != 7)) && printf '        ports:\n        - containerPort: 8080\n'

  cat <<EOF
        resources:
          requests: {cpu: 100m, memory: 128Mi}
          limits: {cpu: 500m, memory: 512Mi}
${POD_ENV_BLOCK}
EOF

  ((arch == 6)) && printf '        securityContext:\n          privileged: true\n'
  ((arch == 8)) && printf '        volumeMounts:\n        - name: hostlib\n          mountPath: /host/lib\n'
  ((arch != 3)) && printf '%s\n' "$PROBES_BLOCK"
  ((arch != 1 && arch != 2)) && emit_pdb "$ns" "$name"

  return 0
}

echo "▸ applying $WORKLOADS workloads"
for ((i = 0; i < WORKLOADS; i++)); do
  emit_workload "$i"
done | apply_stdin workloads
echo "  ✓ workloads applied"

echo "▸ waiting for pods to reach Running (kwok fast-forwards them)"
default_timeout=600
((pods >= 50000)) && default_timeout=1200
((pods >= 150000)) && default_timeout=2700
scale_timeout="${KWOK_SCALE_TIMEOUT:-$default_timeout}"
deadline=$((SECONDS + scale_timeout))
running=0
while :; do
  sampled="$(fleet_deployment_ready_pods || true)"
  if [[ "$sampled" =~ ^[0-9]+$ ]]; then
    if ((sampled >= pods)); then
      confirmed="$(fleet_pod_count Running || true)"
      if [[ "$confirmed" =~ ^[0-9]+$ ]]; then
        running="$confirmed"
        ((running >= pods)) && break
      fi
    else
      running="$sampled"
    fi
  fi
  if ((SECONDS >= deadline)); then
    printf '\r  ✗ only %s/%s pods Running after %ss\n' "$running" "$pods" "$scale_timeout" >&2
    exit 1
  fi
  printf '\r  … %s/%s Running ' "$running" "$pods"
  sleep 8
done
printf '\r  ✓ %s pods Running          \n' "$running"

"$(kwok_root)/verify-padding"

echo
echo "Fleet up:"
printf '  nodes      %s fake + %s real\n' "$(fake_node_count)" \
  "$(kubectl get nodes -l '!type' --chunk-size=0 --no-headers 2>/dev/null | grep -c . || true)"
printf '  workloads  %s across %s namespaces\n' "$WORKLOADS" "$NAMESPACES"
printf '  pods       %s\n' "$pods"
echo
echo "Next: examples/kwok/leeway-scale         # leeway watch marginal memory & CPU"
echo "      examples/kwok/leeway-report-scale  # leeway report client-go & kubectl snapshot"
