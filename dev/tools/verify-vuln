# Run govulncheck against every package.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

GOVULNCHECK_VERSION="v1.1.4"
ensure_tool govulncheck "golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}"

exec govulncheck ./...
