# Fail when go.mod / go.sum are not in `go mod tidy` form.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

tidydir="$(mktemp -d)"
trap 'rm -rf "$tidydir"' EXIT

cp go.mod "$tidydir/go.mod"
cp go.sum "$tidydir/go.sum"

go mod tidy -modfile="$tidydir/go.mod"

untidy=0
for f in go.mod go.sum; do
  if ! diff -u "$f" "$tidydir/$f" >/dev/null 2>&1; then
    untidy=1
  fi
done

if [[ "$untidy" -eq 1 ]]; then
  echo "go.mod / go.sum are not tidy. Run 'go mod tidy' locally and commit the result." >&2
  echo "Diff below is current (-) vs tidied (+):" >&2
  for f in go.mod go.sum; do
    diff -u "$f" "$tidydir/$f" >&2 || true
  done
  exit 1
fi
