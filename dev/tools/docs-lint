# Docs freshness linter for leeway.
#
# Fails on drift patterns in README.md and docs/site/src/content/**/*.
#
# Checks:
#   1. Pinned @vX.Y.Z installs — `go install github.com/go-steer/leeway/...@v0.1.0`
#   2. Wrong-major version pins — "as of v1.5", "Current release: v1.8.0"

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

scoped_paths() {
  find README.md CONTRIBUTING.md SECURITY.md docs/site/src/content -type f \( -name '*.md' -o -name '*.mdx' \) 2>/dev/null | sort
}

check_pinned_installs() {
  local path="$1"
  grep -n -E 'go (get|install)\s+github\.com/go-steer/leeway[^ ]*@v[0-9]+\.[0-9]+\.[0-9]+' "$path" 2>/dev/null | \
    awk -F: -v p="$path" '{
      msg = "pinned @vX.Y.Z in install snippet — use @latest so the doc doesn'\''t rot after the next release";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

check_wrong_major_pins() {
  local path="$1"
  grep -n -E '\bv1\.[0-9]+\.[0-9]+\b' "$path" 2>/dev/null | \
    grep -v -E '^\s*[0-9]+:## \[1\.' | \
    grep -v -E '\(since v1\.' | \
    grep -v -E '\bpre-v1\.[0-9]' | \
    grep -v -E '\bpost-v1\.[0-9]' | \
    grep -v -E 'v1\.[0-9]+(\.[0-9]+)?\+' | \
    awk -F: -v p="$path" '{
      msg = "v1.X.Y in prose — drop the version or convert to a `(since vX.Y.Z)` historical marker";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

run_all_checks() {
  local findings=0
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local out
    out=$(
      check_pinned_installs "$path"
      check_wrong_major_pins "$path"
    )
    if [[ -n "$out" ]]; then
      printf '%s\n' "$out"
      findings=$((findings + $(printf '%s\n' "$out" | wc -l)))
    fi
  done < <(scoped_paths)

  if (( findings > 0 )); then
    echo ""
    echo "docs-lint: $findings finding(s). See remediation hints above."
    return 1
  fi
  return 0
}

self_test() {
  local tmp
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT

  cat > "$tmp/fixture.md" <<'EOF'
# Fixture

Install with:

```
go install github.com/go-steer/leeway/cmd/leeway@v0.1.0
```

Current release: v1.8.0.
EOF

  local out=0
  local n
  n=$(check_pinned_installs "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_pinned_installs fired 0 times, expected ≥1"; out=1; }

  n=$(check_wrong_major_pins "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_wrong_major_pins fired 0 times, expected ≥1"; out=1; }

  if (( out == 0 )); then
    echo "docs-lint self-test: OK"
  fi
  return $out
}

case "${1:-}" in
  --self-test) self_test ;;
  "")          run_all_checks ;;
  *)           echo "usage: $0 [--self-test]" >&2; exit 2 ;;
esac
